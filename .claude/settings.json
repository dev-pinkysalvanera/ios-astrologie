{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild test *)",
      "Bash(xcodebuild -list*)",
      "Bash(deno task *)"
    ],
    "ask": [
      "Bash(supabase functions deploy *)",
      "Bash(supabase db push *)",
      "Bash(TEST_RUNNER_ASTRO_LIVE=1 *)"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git merge *)"
    ]
  }
}
